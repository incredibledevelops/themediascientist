# ============================================================
#  The Media Scientist — Environment Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# ---------- FLASK ----------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# ---------- SECURITY ----------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_64_char_hex

# ---------- SITE ----------
SITE_URL=http://localhost:5004

# ---------- MONGODB ----------
MONGO_URI=mongodb://localhost:27017/media_scientist

# ---------- PAYSTACK ----------
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ---------- EMAIL (Gmail SMTP) ----------
# MAIL_PASSWORD must be a Gmail App Password, NOT your real password
# Generate at: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
MAIL_DEFAULT_SENDER=your_email@gmail.com

# ---------- DEFAULT ADMIN ----------
# Used only to seed the first admin user on first run.
# Change the password via /lab/users after first login.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change_me_strong

# ---------- UPLOADS ----------
# 100 MB in bytes
MAX_CONTENT_LENGTH=104857600