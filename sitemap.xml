<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================
    sitemap.xml — The Media Scientist
    Served dynamically by Flask (app.py route: /sitemap.xml)

    The hardcoded base URL is replaced at request time with the
    value of Config.SITE_URL. Never edit the base URL manually —
    change SITE_URL in your .env file instead.

    Update <lastmod> dates when you publish new content:
      - Home         : when hero/featured content changes
      - About        : when bio/skills/timeline change
      - Services     : when plans/pricing change
      - Portfolio    : when portfolio items added/removed
      - Contact      : when contact details change
    ============================================================
-->
